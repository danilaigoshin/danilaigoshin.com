{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/Danila_Igoshin_EMEA_Contract_CV",
      "destination": "/Danila_Igoshin_Product_Engineer_CV.pdf",
      "permanent": true
    },
    {
      "source": "/Danila_Igoshin_EMEA_Contract_CV.pdf",
      "destination": "/Danila_Igoshin_Product_Engineer_CV.pdf",
      "permanent": true
    },
    {
      "source": "/Danila_Igoshin_Senior_Frontend_Engineer_CV.pdf",
      "destination": "/Danila_Igoshin_Product_Engineer_CV.pdf",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/Danila_Igoshin_Senior_Frontend_Engineer_CV",
      "destination": "/Danila_Igoshin_Product_Engineer_CV.pdf"
    },
    {
      "source": "/Danila_Igoshin_Product_Engineer_CV",
      "destination": "/Danila_Igoshin_Product_Engineer_CV.pdf"
    },
    {
      "source": "/Danila_Igoshin_Full_Stack_Engineer_CV",
      "destination": "/Danila_Igoshin_Full_Stack_Engineer_CV.pdf"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=(), interest-cohort=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/public/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public/optimized/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
